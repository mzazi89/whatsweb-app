# Port the web app listens on
PORT=3000

# Optional. When set, the site asks for this password before showing anything.
# Strongly recommended if you put this on the public internet.
ACCESS_PASSWORD=

# Optional. Restrict to one phone number (international format, digits only).
# Leave empty to allow whichever number links first.
ALLOWED_NUMBER=

# Optional Postgres (Neon). When set, the linked-device credentials and the
# message history live in the database instead of data/, so a redeploy does
# not force a re-link.
DATABASE_URL=
# 32+ random characters. Encrypts the WhatsApp credentials before they are
# written. Rotating it unlinks the device (the old rows can no longer be read).
SESSION_KEY=
# Separate accounts in one database; defaults to "default".
ACCOUNT_ID=
